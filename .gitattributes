# Shell scripts run inside Linux containers; keep LF regardless of autocrlf.
*.sh text eol=lf
Dockerfile text eol=lf
# Generated outputs are written with LF on every platform; check them out the
# same way so the byte counts in _manifest.csv match the files on disk.
data/powerbi/*.csv text eol=lf
data/processed/*.csv text eol=lf
reports/results.json text eol=lf
reports/validation/*.json text eol=lf
